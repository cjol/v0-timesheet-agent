  "automationRules": [
    {
      "id": "rule-1",
      "title": "Insufficient Detail",
      "description": "Automatically detect and request clarification for entries lacking sufficient detail",
      "references": ["Client Billing Guidelines", "Matter Context"],
      "steps": [
        {
          "number": "1",
          "description": "Request Clarification from Time Keeper",
          "code": "// Request clarification for insufficient detail\nconst entry = getTimeEntry(entryId);\nif (entry.task.length < 20) {\n  sendEmail(entry.timekeeper, {\n    subject: 'Clarification Needed',\n    body: 'Please provide more detail for your time entry.'\n  });\n  markForReview(entry, 'insufficient-detail');\n}"
        },
        {
          "number": "1b",
          "description": "Resend clarification request if unaddressed every 3 days",
          "code": "// Scheduled job to resend requests\nconst unresolvedEntries = getUnresolvedEntries('insufficient-detail');\nunresolvedEntries.forEach(entry => {\n  if (daysSinceCreated(entry) % 3 === 0) {\n    resendClarificationEmail(entry);\n  }\n});"
        },
        {
          "number": "2",
          "description": "Rewrite Narrative to include clarification",
          "code": "// Auto-rewrite with AI assistance\nconst clarification = await getTimekeeperResponse(entryId);\nconst improvedTask = await improveTaskDescription(\n  entry.task,\n  clarification\n);\nentry.suggestedTask = improvedTask;"
        },
        {
          "number": "3",
          "description": "Raise for Approval",
          "code": "// Submit for review\nupdateReviewStatus(entry, {\n  status: 'pending-approval',\n  suggestedText: entry.suggestedTask,\n  originalText: entry.task\n});"
        }
      ]
    },
    {
      "id": "rule-2",
      "title": "Poor Writing Style",
      "description": "Identify and improve poorly formatted or unclear time entry descriptions",
      "references": ["Client Billing Guidelines", "Style Guide"],
      "steps": [
        {
          "number": "1",
          "description": "Detect Poor Writing Quality",
          "code": "// Analyze writing quality\nconst quality = analyzeWritingQuality(entry.task);\nif (quality.score < 0.6) {\n  flagEntry(entry, 'poor-writing');\n}"
        },
        {
          "number": "2",
          "description": "Generate Improved Version",
          "code": "// Generate improved description\nconst improved = await generateImprovement(entry.task, {\n  tone: 'professional',\n  style: 'concise',\n  maxLength: 100\n});\nentry.suggestedTask = improved;"
        },
        {
          "number": "3",
          "description": "Notify Timekeeper and Request Approval",
          "code": "// Send improvement suggestion\nsendNotification(entry.timekeeper, {\n  type: 'writing-improvement',\n  original: entry.task,\n  suggested: entry.suggestedTask,\n  action: 'approve-or-edit'\n});"
        }
      ]
    },
    {
      "id": "rule-3",
      "title": "Unusual Duration",
      "description": "Flag entries with atypical time durations for review",
      "references": ["Matter Context", "Billing Guidelines"],
      "steps": [
        {
          "number": "1",
          "description": "Analyze Duration Against Historical Data",
          "code": "// Check if duration is unusual\nconst avgDuration = getAverageTaskDuration(entry.task);\nconst threshold = avgDuration * 1.5;\nif (entry.duration > threshold) {\n  flagEntry(entry, 'unusual-duration');\n}"
        },
        {
          "number": "2",
          "description": "Request Clarification or Adjustment",
          "code": "// Send review request\nsendReviewRequest(entry, {\n  reason: 'Duration significantly higher than average',\n  suggestedAction: 'Verify or split into multiple entries',\n  averageDuration: avgDuration\n});"
        }
      ]
    }
  ]
}
